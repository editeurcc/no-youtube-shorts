{
  "manifest_version": 2,
  "name": "No YouTube Shorts",
  "version": "1.0.0",
  "description": "Bloque l'interface « Shorts » de YouTube et restaure l'affichage classique des vidéos.",

  "permissions": [
    "webNavigation",
    "storage",
    "*://*.youtube.com/*"
  ],

  "browser_action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "No YouTube Shorts"
  },

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],

  "background": {
    "scripts": ["background.js"],
    "persistent": false
  },

  "browser_specific_settings": {
    "gecko": {
      "id": "no-youtube-shorts@editeurcc.github.io",
      "strict_min_version": "58.0"
    }
  }
}
